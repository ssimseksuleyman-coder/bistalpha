__pycache__/
*.pyc
*.tmp
*.bozuk*
logs/
optimizer_suggestions.json
# NOT: portfolios/ İGNORE EDİLMEZ — F-state kalıcılığı için commit edilir.
# (deniz_snapshots/ ARTIK ignore — Deniz lisanslı-türev; aşağıda local'e alındı.)

.venv/
.env
*.log

# Kişisel-operasyonel notlar (repo PUBLIC — strateji/beklenti/bloker açığa çıkmasın).
# CANLI_HAZIRLIK.md gibi go-live referansları + gelecekteki kişisel notlar buraya.
local/

# Deniz bulteninden turetilmis statik temel veri local kalir.
# Kod public olabilir; lisansli/turev veri PDF gibi repoya commit edilmez.
# deniz_inbox/ = ham Deniz PDF'leri (en hassas); kaza-git-add korumasi (history'de degil, sadece untracked).
deniz_inbox/
# data/omega/ = TUMU Deniz-bulten-turevi extract (_meta.source=Deniz Yatirim); hepsi local kalir.
data/omega/*.json
# Deniz gunluk bulten snapshot'lari (parse-edilmis tescilli veri) local kalir.
deniz_snapshots/*
# scanner_state.json = tarama-imleci (Deniz-arastirma DEGIL); cloud-fetch surdukce tracked kalir.
!deniz_snapshots/scanner_state.json
